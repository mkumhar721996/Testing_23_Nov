# PostgreSQL connection string (required; no default)
DATABASE_URL=postgres://user:password@localhost:5432/operations
# Web app origin allowed by CORS; leave unset to keep CORS off
WEB_ORIGIN=http://localhost:5173
# TEMPORARY, development only (ignored when NODE_ENV=production): treat every request as this customer id
# until Entra ID auth ships. Without it, GET /orders and GET /orders/:id return 401.
DEV_CUSTOMER_ID=00000000-0000-0000-0000-000000000001
