{
  "name": "operations-api",
  "version": "0.0.1",
  "private": true,
  "description": "Operations API (comp_operations_api)",
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "migrate": "node-pg-migrate -m migrations",
    "e2e":"vitest run --config vitest.config.e2e.ts",
    "devloop": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/pg": "^8.23.1",
    "jose": "^6.2.18",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
